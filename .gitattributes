# ---------------------------------------------------------------
# Line endings
# ---------------------------------------------------------------
* text=auto eol=lf

# Unity YAML assets stay as text so they can be diffed and merged.
# (Requires Project Settings > Editor > Asset Serialization = Force Text)
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.physicMaterial  text eol=lf
*.meta       text eol=lf
*.cs         text eol=lf diff=csharp
*.shader     text eol=lf
*.hlsl       text eol=lf
*.cginc      text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.asmdef     text eol=lf
*.inputactions text eol=lf

# Unity merges .unity / .prefab with its own smart merge tool when configured
*.unity   merge=unityyamlmerge
*.prefab  merge=unityyamlmerge
*.asset   merge=unityyamlmerge

# A baked NavMesh is binary even under Force Text serialization. Left under the
# `text` rule above, git "normalises" CRLF inside the binary payload and quietly
# destroys it - which is exactly how the house scene was lost once. Anything
# holding a bake is declared binary explicitly.
*NavMesh*.asset  -text -diff -merge
NavMesh*.asset   -text -diff -merge

# ---------------------------------------------------------------
# Git LFS — binary assets only
# ---------------------------------------------------------------
# 3D models
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.FBX    filter=lfs diff=lfs merge=lfs -text
*.obj    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.dae    filter=lfs diff=lfs merge=lfs -text
*.glb    filter=lfs diff=lfs merge=lfs -text

# Textures
